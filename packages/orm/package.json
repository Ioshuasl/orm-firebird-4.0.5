{
  "name": "ocr-firebird",
  "version": "0.1.0",
  "description": "Sequelize-like Firebird ORM compatible with JavaScript and TypeScript.",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "firebird",
    "orm",
    "sequelize-like",
    "javascript",
    "typescript",
    "nodejs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "node-firebird": "^2.0.2"
  }
}
